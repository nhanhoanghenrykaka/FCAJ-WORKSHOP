# RDS PostgreSQL
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=shopsflow
DB_USERNAME=shopsflow_admin
DB_PASSWORD=replace-with-a-strong-password

# Application
JWT_SECRET=replace-with-a-base64-secret
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://your-domain-or-elastic-ip

# Initial administrator. Change the password after first deployment by rotating
# this value and recreating the database user if required by your process.
APP_SEED_ADMIN_EMAIL=admin@shopsflow.com
APP_SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_SEED_ADMIN_NAME=Shopsflow Admin

# Optional S3 backup
S3_BACKUP_BUCKET=your-private-shopsflow-backup-bucket
AWS_REGION=ap-southeast-1

# Optional demo data on AWS
APP_SEED_DEMO_DATA=false
APP_SEED_DEMO_USER_EMAIL=customer@shopsflow.com
APP_SEED_DEMO_USER_PASSWORD=Customer123!

# Optional VNPay Sandbox integration. For a public EC2 IP, use for example:
# VNPAY_RETURN_URL=http://YOUR_EC2_PUBLIC_IP/payment-result
# VNPAY_IPN_URL=http://YOUR_EC2_PUBLIC_IP/api/payment/vnpay/callback
# Gmail SMTP for registration OTP verification.
# MAIL_USERNAME is the Gmail account that sends OTP emails.
# Use a Google App Password for MAIL_PASSWORD, not your normal Gmail password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-shop-email@gmail.com
MAIL_PASSWORD=replace-with-google-app-password
MAIL_FROM=your-shop-email@gmail.com
REGISTRATION_OTP_EXPIRATION_MINUTES=5
REGISTRATION_OTP_RESEND_COOLDOWN_SECONDS=60
REGISTRATION_OTP_MAX_ATTEMPTS=5
REGISTRATION_VERIFICATION_VALID_MINUTES=15

# Google Identity Services (Web OAuth client ID).
# Create a Web application client in Google Cloud. Use the same Client ID in
# backend verification and frontend rendering. No client secret is needed for
# the Sign in with Google ID-token flow used by Shopsflow.
GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
VNPAY_API_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_USD_TO_VND_RATE=25000

# Optional Cloudinary unsigned upload settings. Rebuild the frontend after changing them.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=


# Usually set this to the same value as GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com

# Persistent backend storage for profile images.
APP_UPLOAD_DIR=/app/uploads
