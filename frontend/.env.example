# Leave this as /api when using the Vite proxy with a backend on localhost:8080.
VITE_API_BASE_URL=/api

# Optional: direct Admin image upload via an unsigned Cloudinary preset.
# These values are public build-time frontend settings, not API secrets.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=


# Google Identity Services Web OAuth client ID (public client identifier, not a secret).
VITE_GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
